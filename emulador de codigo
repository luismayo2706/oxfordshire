        function switchLanguage(lang) {
            currentLang = lang;
            ['c', 'cpp', 'python'].forEach(l => {
                const btn = document.getElementById(`btn-${l}`);
                if (l === lang) {
                    btn.className = "px-3 py-1.5 text-xs font-semibold rounded-lg transition-all bg-cyan-600 text-white shadow";
