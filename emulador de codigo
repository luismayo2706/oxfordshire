        function onEditorInput() {
            updateHighlighting();
            updateLineNumbers();
            updateCursorPos();
        }

        function updateHighlighting() {
            const editor = document.getElementById('code-editor');
            const highlightLayer = document.getElementById('highlight-layer');
            let code = editor.value;

            // Escape HTML characters to prevent XSS in syntax layer
            code = code.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

            // Simple robust regex syntax tokenizer for C/C++/Python
            // Comments
            code = code.replace(/(\/\/[^\n]*|\/\*[\s\S]*?\*\/|#[^\n]*)/g, '<span class="token-comment">$1</span>');
            // Strings
            code = code.replace(/(&quot;[^&]*?&quot;|&#39;[^']*?&#39;|"[^"]*?"|'[^']*?')/g, '<span class="token-string">$1</span>');
            // Keywords
            const keywords = /\b(int|float|double|char|void|bool|long|vector|string|include|using|namespace|return|if|else|for|while|do|switch|case|break|continue|struct|class|public|private|def|print|import|from|in|and|or|not|as)\b/g;
            code = code.replace(keywords, '<span class="token-keyword">$1</span>');
            // Numbers
            code = code.replace(/\b(\d+)\b/g, '<span class="token-number">$1</span>');

            highlightLayer.innerHTML = code + '\n';
        }

        function updateLineNumbers() {
            const editor = document.getElementById('code-editor');
            const lines = editor.value.split('\n').length;
            let numbersStr = '';
            for (let i = 1; i <= lines; i++) {
                numbersStr += i + '\n';
            }
            document.getElementById('line-numbers').innerText = numbersStr;
        }

        function syncScroll() {
            const editor = document.getElementById('code-editor');
            const lineNumbers = document.getElementById('line-numbers');
            const highlightLayer = document.getElementById('highlight-layer');
            lineNumbers.scrollTop = editor.scrollTop;
            highlightLayer.scrollTop = editor.scrollTop;
            highlightLayer.scrollLeft = editor.scrollLeft;
        }

        function updateCursorPos() {
            const editor = document.getElementById('code-editor');
            const pos = editor.selectionStart;
            const textBefore = editor.value.substring(0, pos);
            const lines = textBefore.split('\n');
            const line = lines.length;
            const col = lines[lines.length - 1].length + 1;
            document.getElementById('cursor-pos').innerText = `Ln ${line}, Col ${col}`;
        }

        function handleTab(e) {
            if (e.key === 'Tab') {
                e.preventDefault();
                const editor = document.getElementById('code-editor');
                const start = editor.selectionStart;
                const end = editor.selectionEnd;
                editor.value = editor.value.substring(0, start) + "    " + editor.value.substring(end);
                editor.selectionStart = editor.selectionEnd = start + 4;
                onEditorInput();
            }
        }

        function copyCode() {
            const code = document.getElementById('code-editor').value;
            const textarea = document.createElement('textarea');
            textarea.value = code;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);
            showNotification("¡Código copiado al portapapeles con éxito!", "success");
        }

        function formatCode() {
            const editor = document.getElementById('code-editor');
            let lines = editor.value.split('\n');
            let indent = 0;
            let formatted = [];
            
            for(let line of lines) {
                let trimmed = line.trim();
                if(trimmed.startsWith('}') || trimmed.startsWith(']')) indent = Math.max(0, indent - 4);
                let spaces = ' '.repeat(indent);
                formatted.push(spaces + trimmed);
                if(trimmed.endsWith('{') || trimmed.endsWith(':')) indent += 4;
            }
            editor.value = formatted.join('\n');
            onEditorInput();
            showNotification("Código formateado y tabulado correctamente.", "success");
        }

        function openSnippetsModal() {
            document.getElementById('snippets-modal').classList.remove('hidden');
        }

        function closeSnippetsModal() {
            document.getElementById('snippets-modal').classList.add('hidden');
        }

        function loadSnippet(key) {
            if(snippets[key]) {
                document.getElementById('code-editor').value = snippets[key];
                onEditorInput();
                closeSnippetsModal();
                showNotification("Snippet cargado en el editor.", "success");
            }
        }

        function clearCurrentTab() {
            const termPanel = document.getElementById('panel-terminal');
            if(!termPanel.classList.contains('hidden')) {
                document.getElementById('terminal-output').innerText = "// Consola limpia.";
                document.getElementById('exec-status').innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-slate-500"></span> En espera';
                document.getElementById('exec-time').innerText = "0.00s";
            } else {
                document.getElementById('ai-output').innerHTML = '<div class="p-3 bg-slate-900/80 border border-slate-800 rounded-xl"><p class="text-slate-400 italic">Panel limpiado.</p></div>';
            }
        }

        function showNotification(msg, type) {
            const term = document.getElementById('terminal-output');
            term.innerText += `\n[INFO (${new Date().toLocaleTimeString()}): ${msg}\n`;
            term.scrollTop = term.scrollHeight;
        }

        function analyzeCodeAI() {
            const code = document.getElementById('code-editor').value;
            const aiOutput = document.getElementById('ai-output');
            
            aiOutput.innerHTML = `
                <div class="p-4 bg-slate-900/90 border border-purple-500/30 rounded-xl space-y-3 shadow-lg animate-pulse">
                    <div class="flex items-center space-x-2 text-purple-400 font-semibold text-xs">
                        <i class="fa-solid fa-circle-notch fa-spin"></i>
                        <span>Analizando sintaxis, estructura y propósito del script...</span>
                    </div>
                </div>
            `;

            setTimeout(() => {
                let analysis = generateSmartAnalysis(code, currentLang);
                aiOutput.innerHTML = analysis;
            }, 600);
        }

        function generateSmartAnalysis(code, lang) {
            let lineCount = code.split('\n').length;
            let hasLoop = code.includes('for') || code.includes('while');
            let hasCondition = code.includes('if');
            let hasFunction = code.includes('int ') || code.includes('void ') || code.includes('def ');
            let hasIo = code.includes('printf') || code.includes('cout') || code.includes('print');

            let purposeHTML = "";
            if (code.includes('Fibonacci')) {
                purposeHTML = "Calcula la clásica secuencia numérica de Fibonacci sumando los dos términos anteriores de forma iterativa.";
            } else if (code.includes('burbuja') || code.includes('arr[j] > arr[j+1]')) {
                purposeHTML = "Implementa el algoritmo de ordenamiento Burbuja (Bubble Sort) comparando elementos adyacentes e intercambiándolos.";
            } else if (code.includes('struct')) {
                purposeHTML = "Demuestra el uso de estructuras de datos personalizadas (structs) para modelar registros complejos en memoria.";
            } else if (code.includes('matriz') || code.includes('matriz[3][3]')) {
                purposeHTML = "Realiza el recorrido y despliegue de una matriz bidimensional (tabla de 3x3) mediante bucles anidados.";
            } else if (lang === 'python') {
                purposeHTML = "Ejecuta un script interpretado en Python con filtrado de datos mediante comprensión de listas y operaciones nativas.";
            } else {
                purposeHTML = "Programa estructural en " + lang.toUpperCase() + " diseñado para procesamiento de datos, cómputo aritmético y control de flujo.";
            }

            return `
                <div class="space-y-3">
                    <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                        <h4 class="text-xs font-bold text-cyan-400 flex items-center gap-2">
                            <i class="fa-solid fa-bullseye"></i> Propósito General
                        </h4>
                        <p class="text-slate-300 text-[11px] leading-relaxed">${purposeHTML}</p>
                    </div>

                    <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                        <h4 class="text-xs font-bold text-indigo-400 flex items-center gap-2">
                            <i class="fa-solid fa-code"></i> Desglose Estructural (${lang.toUpperCase()})
                        </h4>
                        <ul class="text-[11px] text-slate-300 space-y-1.5 list-disc list-inside">
                            <li><strong>Líneas totales:</strong> ${lineCount} líneas de código analizadas.</li>
                            <li><strong>Bucles e Iteraciones:</strong> ${hasLoop ? 'Sí, contiene bucles de control.' : 'No detectados.'}</li>
                            <li><strong>Condicionales lógicas:</strong> ${hasCondition ? 'Sí, incluye estructuras de decisión.' : 'No detectadas.'}</li>
                            <li><strong>E/S (Entrada/Salida):</strong> ${hasIo ? 'Operaciones de impresión en pantalla activas.' : 'Sin salida visible.'}</li>
                        </ul>
                    </div>

                    <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-xl space-y-2">
                        <h4 class="text-xs font-bold text-emerald-400 flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved"></i> Calidad y Buenas Prácticas
                        </h4>
                        <p class="text-slate-300 text-[11px] leading-relaxed">
                            El código respeta las normas de sintaxis para <strong>${lang.toUpperCase()}</strong>. Se recomienda mantener sangrías consistentes y validar desbordamientos de búfer en estructuras de entrada.
                        </p>
                        <div class="text-[10px] text-slate-500 pt-1 border-t border-slate-800">
                            Analizador inteligente optimizado para Ing. Jose Luis Mayo Galeana
                        </div>
                    </div>
                </div>
            `;
        }

        function runCode() {
            const code = document.getElementById('code-editor').value;
            const stdin = document.getElementById('stdin-input').value;
            const terminal = document.getElementById('terminal-output');
            const statusIndicator = document.getElementById('exec-status');
            const execTimeLabel = document.getElementById('exec-time');

            statusIndicator.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-yellow-500 animate-pulse"></span> Validando y compilando...';
            terminal.innerText = `[CodeForge Compiler v4.1 - Ing. Jose Luis Mayo Galeana]\n[+] Verificando estructura estricta y sintaxis de ${currentLang.toUpperCase()}...\n`;

            const startTime = performance.now();

            setTimeout(() => {
                const endTime = performance.now();
                const duration = ((endTime - startTime) / 1000).toFixed(2);
                execTimeLabel.innerText = `${duration}s`;

                try {
                    // Validaciones estrictas de sintaxis y elementos faltantes
                    validateStrictSyntax(code, currentLang);

                    let output = "";
                    if (currentLang === 'python') {
                        output = emulatePythonExecution(code, stdin);
                    } else {
                        output = emulateCppExecution(code, stdin);
                    }

                    terminal.innerText = `=== RESULTADO DE EJECUCIÓN (${currentLang.toUpperCase()}) ===\n`;
                    terminal.innerText += output;
                    terminal.innerText += `\n\n[Proceso finalizado correctamente (exit code 0)]`;
                    
                    statusIndicator.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-sm"></span> Ejecución exitosa';
                } catch (err) {
                    terminal.innerText += `\n[Error de Compilación]:\n${err.message}\n\n[Proceso abortado con errores (exit code 1)]`;
                    statusIndicator.innerHTML = '<span class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-sm"></span> Error de Sintaxis';
                }

                terminal.scrollTop = terminal.scrollHeight;
            }, 450);
        }

        function validateStrictSyntax(code, lang) {
            if (lang === 'c' || lang === 'cpp') {
                // Verificar función main obligatoria
                if (!/\bint\s+main\s*\(\s*\)/.test(code) && !/\bvoid\s+main\s*\(\s*\)/.test(code)) {
                    throw new Error("error: 'main' must return 'int' or 'void' and accept parameters or empty parentheses.\n -> Falta la función principal obligatoria 'int main()'.");
                }

                // Validar balance de llaves { }
                let openBraces = (code.match(/{/g) || []).length;
                let closeBraces = (code.match(/}/g) || []).length;
                if (openBraces !== closeBraces) {
                    throw new Error(`error: expected '}' or '{' unmatched brace block.\n -> Llaves desbalanceadas: Se abrieron ${openBraces} y se cerraron ${closeBraces}. Revisa tu código.`);
                }

                // Validar balance de paréntesis ( )
                let openParens = (code.match(/\(/g) || []).length;
                let closeParens = (code.match(/\)/g) || []).length;
                if (openParens !== closeParens) {
                    throw new Error(`error: unmatched parenthesis '(' or ')' detected.\n -> Paréntesis desbalanceados: Hay ${openParens} aperturas y ${closeParens} cierres.`);
                }

                // Validar punto y coma faltante en sentencias básicas (printf / cout / return / asignaciones)
                let lines = code.split('\n');
                for (let i = 0; i < lines.length; i++) {
                    let l = lines[i].trim();
                    if (l === '' || l.startsWith('#') || l.startsWith('//') || l.startsWith('/*') || l.endsWith('*/') || l.endsWith('{') || l.endsWith('}') || l.includes('for(') || l.includes('while(') || l.includes('if(') || l.includes('else')) {
                        continue;
                    }
                    // Si la línea parece una sentencia ejecutable pero no termina en ';'
                    if ((l.includes('printf') || l.includes('cout') || l.includes('return') || l.includes('int ') || l.includes('float ') || l.includes('double ') || l.includes('char ') || l.includes('long ') || l.includes('vector ')) && !l.endsWith(';')) {
                        throw new Error(`error at line ${i + 1}: expected ';' before end of line.\n -> Línea ${i + 1}: Falta el punto y coma ';' al final de la instrucción.`);
                    }
                }
            } else if (lang === 'python') {
                // Validar bloques de Python con dos puntos
                let lines = code.split('\n');
                for (let i = 0; i < lines.length; i++) {
                    let l = lines[i].trim();
                    if (l.startsWith('def ') || l.startsWith('for ') || l.startsWith('while ') || l.startsWith('if ') || l.startsWith('elif ') || l.startsWith('else:')) {
                        if (!l.endsWith(':')) {
                            throw new Error(`SyntaxError at line ${i + 1}: expected ':'\n -> Línea ${i + 1}: Falta el carácter ':' al final de la definición.`);
                        }
                    }
                }
            }
        }

        function emulateCppExecution(code, stdin) {
            let results = [];
            let lines = code.split('\n');

            for (let line of lines) {
                line = line.trim();
                
                if (line.startsWith('printf(')) {
                    let match = line.match(/printf\s*\(\s*"([^"]*)"(?:\s*,\s*(.+))?\s*\)\s*;/);
                    if (match) {
                        let formatStr = match[1].replace(/\\n/g, '\n').replace(/\\t/g, '\t');
                        if (match[2]) {
                            formatStr = formatStr.replace(/%[difs]/g, match[2].trim());
                        }
                        results.push(formatStr);
                    }
                }
                
                if (line.includes('cout <<')) {
                    let parts = line.split('<<');
                    let printed = [];
                    for (let i = 1; i < parts.length; i++) {
                        let part = parts[i].trim().replace(';', '');
                        if (part.startsWith('"') && part.endsWith('"')) {
                            printed.push(part.slice(1, -1));
                        } else if (part === 'endl') {
                            printed.push('\n');
                        } else {
                            printed.push(part);
                        }
                    }
                    results.push(printed.join(''));
                }
            }

            if (results.length === 0) {
                results.push("El programa se ejecutó correctamente, pero no emitió ninguna salida visible.");
            }

            if (stdin) {
                results.push(`\n[Entrada estándar leída (stdin)]: ${stdin}`);
            }

            return results.join('');
        }

        function emulatePythonExecution(code, stdin) {
            let logs = [];
            let lines = code.split('\n');

            for (let line of lines) {
                line = line.trim();
                if (line.startsWith('#') || line === '' || line.startsWith('"""')) continue;

                if (line.startsWith('print(')) {
                    let content = line.substring(6, line.length - 1);
                    if ((content.startsWith('"') && content.endsWith('"')) || (content.startsWith("'") && content.endsWith("'"))) {
                        logs.push(content.slice(1, -1));
                    } else if (content.startsWith('f"') || content.startsWith("f'")) {
                        logs.push(content.slice(2, -1));
                    } else {
                        try {
                            let evaluated = eval(content.replace(/print/g, ''));
                            logs.push(evaluated !== undefined ? evaluated : content);
                        } catch(e) {
                            logs.push(content);
                        }
                    }
                }
            }

            if (logs.length === 0) {
                logs.push("Script de Python ejecutado sin sentencias print.");
            }

            if (stdin) {
                logs.push(`[input() recibido]: ${stdin}`);
            }

            return logs.join('\n');
        }
    </script>
