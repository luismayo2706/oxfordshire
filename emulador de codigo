    <style>
        body { font-family: 'Inter', sans-serif; }
        .code-font { font-family: 'Fira Code', monospace; }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0f172a; }
        ::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }
        .glow-effect { box-shadow: 0 0 25px -5px rgba(6, 182, 212, 0.15); }
        
        /* Highlight colors for syntax recognition */
        .token-keyword { color: #f472b6; font-weight: 600; }
        .token-type { color: #38bdf8; font-weight: 600; }
        .token-string { color: #34d399; }
        .token-comment { color: #64748b; font-style: italic; }
        .token-number { color: #fbbf24; }
        .token-function { color: #a78bfa; }
    </style>
